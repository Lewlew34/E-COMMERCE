# ===================================================================
# 1. DATABASE CONFIGURATION (Dùng cho PHP Backend kết nối MySQL)
# ===================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=techecommercedb
DB_USER=root
DB_PASS=

# ===================================================================
# 2. CORS & FRONTEND URL (PHP Backend cho phép nguồn gọi API)
# ===================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===================================================================
# 3. BACKEND API URL (Frontend Vite/React gọi API)
# Lưu ý: Cập nhật đường dẫn theo thư mục htdocs trong XAMPP của bạn
# Ví dụ: http://localhost/TechMart/Backend/api hoặc http://localhost/E-COMMERCE/Backend/api
# ===================================================================
VITE_API_URL=http://localhost/TechMart/Backend/api

# ===================================================================
# 4. TÍCH HỢP TƯ VẤN TRỰC TUYẾN TAWK.TO (Tùy chọn)
# ===================================================================
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
